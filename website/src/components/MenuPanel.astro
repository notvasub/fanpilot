---
// Mirrors Sources/FanPilot/MenuContentView.swift. Rows and states are filled in by lib/panel.ts.
import Icon from './Icon.astro';

const fans = [
  { index: 0, name: 'Left fan' },
  { index: 1, name: 'Right fan' },
];
---
<div class="mp vibrancy mac-ui" data-panel role="dialog" aria-label="FanPilot menu">
  <div class="mp__head">
    <b>FanPilot</b>
    <span class="mp__cpu muted tnum"><Icon name="cpu" /><span data-bind="cpuLine">44 °C avg · 47 °C max</span></span>
  </div>

  <div class="mp__banner" data-banner hidden>
    <p data-banner-text></p>
    <div class="mp__banner-actions" data-banner-actions></div>
  </div>

  <div class="mp__fans">
    {
      fans.map((fan) => (
        <div class="mp__fan" data-fan={fan.index}>
          <div class="mp__fan-top">
            <span>{fan.name}</span>
            <span class="mac-badge" data-badge>Auto</span>
            <span class="mp__rpm tnum" data-rpm>0 RPM</span>
          </div>
          <div class="mac-progress"><i data-bar /></div>
          <div class="mp__fan-sub muted tnum" data-sub>2317–7826 RPM · target 0</div>
        </div>
      ))
    }
  </div>

  <hr />

  <div class="mp__profiles">
    <span class="mp__label muted">Profiles</span>
    <div class="mp__list" data-profile-list role="radiogroup" aria-label="Profiles"></div>
  </div>

  <hr />

  <div class="mp__manual">
    <div class="mp__row">
      <span class="mp__label muted">Manual speed</span>
      <span class="tnum" data-manual-pct></span>
    </div>
    <div class="mp__slider">
      <button class="mac-btn mac-btn--icon mac-btn--plain" type="button" data-nudge="-1" aria-label="Slower by one step"><Icon name="minus" /></button>
      <input class="mac-range" type="range" min="0" max="100" step="1" value="0" data-manual-range aria-label="Manual speed, percent of fan range" />
      <button class="mac-btn mac-btn--icon mac-btn--plain" type="button" data-nudge="1" aria-label="Faster by one step"><Icon name="plus" /></button>
    </div>
    <div class="mp__save" data-save-area></div>
  </div>

  <div class="mp__hint muted">
    <span data-bind="hintStep">fn F4 / fn F5 — slower / faster by 10%</span>
    <span>fn ⇧F4 — automatic &nbsp;·&nbsp; fn ⇧F5 — next profile</span>
  </div>

  <div class="mp__foot">
    <div class="mp__menu">
      <button class="mac-btn mac-btn--plain" type="button" data-helper-menu-btn aria-haspopup="menu" aria-expanded="false">
        <span data-bind="helperStatus">Helper: running</span><Icon name="chevron" />
      </button>
      <div class="mp__pop vibrancy" role="menu" data-helper-menu hidden></div>
    </div>
    <button class="mac-btn mac-btn--plain" type="button" data-open-profiles>Profiles…</button>
    <button class="mac-btn mac-btn--plain" type="button" data-quit>Quit</button>
  </div>
</div>

<style is:global>
  .mp {
    width: 320px;
    padding: 14px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }
  .mp hr {
    margin: 0;
    border: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
  }
  .mp__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .mp__head b {
    font-size: 13.5px;
    font-weight: 700;
  }
  .mp__cpu {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
  }
  .mp__cpu .icon {
    width: 13px;
    height: 13px;
  }
  .mp__banner {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    border-radius: 8px;
    background: rgba(255, 149, 0, 0.16);
    font-size: 12.5px;
    line-height: 1.35;
  }
  .mp__banner[hidden] {
    display: none;
  }
  .mp__banner-actions {
    display: flex;
    gap: 6px;
  }
  .mp__fans {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .mp__fan {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mp__fan-top {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .mp__rpm {
    margin-left: auto;
  }
  .mp__fan-sub {
    font-size: 12px;
  }
  .mp__label {
    font-size: 12px;
  }
  .mp__profiles {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .mp__list {
    display: flex;
    flex-direction: column;
  }
  .mp__item {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    padding: 3px 4px;
    margin: 0 -4px;
    width: calc(100% + 8px);
    border: 0;
    border-radius: 5px;
    background: transparent;
    text-align: left;
    font: 13px/1.3 var(--mac);
    color: var(--frost);
  }
  .mp__item:hover {
    background: rgba(255, 255, 255, 0.07);
  }
  .mp__radio {
    width: 14px;
    height: 14px;
    flex: none;
    border-radius: 50%;
    border: 1.4px solid rgba(245, 245, 247, 0.55);
    display: grid;
    place-items: center;
  }
  .mp__item[aria-checked='true'] .mp__radio {
    border: 0;
    background: var(--heat);
    color: var(--heat-ink);
  }
  .mp__radio .icon {
    width: 10px;
    height: 10px;
  }
  .mp__item small {
    margin-left: auto;
    font-size: 12px;
    color: rgba(245, 245, 247, 0.62);
    white-space: nowrap;
  }
  .mp__manual {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mp__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mp__slider {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .mp__save {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .mp__save:empty {
    display: none;
  }
  .mp__save .mac-input {
    flex: 1;
  }
  .mp__hint {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
  }
  .mp__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 -6px -4px;
  }
  .mp__foot .icon {
    width: 10px;
    height: 10px;
    opacity: 0.7;
  }
  .mp__menu {
    position: relative;
  }
  .mp__pop {
    position: absolute;
    left: 0;
    bottom: calc(100% + 4px);
    z-index: 5;
    min-width: 210px;
    padding: 5px;
    border-radius: 9px;
    display: flex;
    flex-direction: column;
  }
  .mp__pop[hidden] {
    display: none;
  }
  .mp__pop button {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 8px 0 22px;
    position: relative;
    border: 0;
    border-radius: 5px;
    background: transparent;
    font: 13px/1 var(--mac);
    color: var(--frost);
    text-align: left;
  }
  .mp__pop button:hover,
  .mp__pop button:focus-visible {
    background: var(--heat);
    color: var(--heat-ink);
    outline: none;
  }
  .mp__pop button .icon {
    position: absolute;
    left: 6px;
    width: 11px;
    height: 11px;
    opacity: 1;
  }
  .mp__pop hr {
    margin: 4px 8px;
  }
  .mp__pop .mp__pop-label {
    padding: 4px 8px 2px;
    font-size: 12px;
    color: rgba(245, 245, 247, 0.55);
  }
</style>
