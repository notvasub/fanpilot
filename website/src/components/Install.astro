---
import Icon from './Icon.astro';
import { REPO_URL, REPO_LABEL } from '../config';

const steps = [
  {
    title: 'Get the code',
    text: 'FanPilot is open source. Clone it from GitHub.',
    cmds: [`git clone ${REPO_URL}.git`, 'cd fanpilot'],
  },
  {
    title: 'Build and install',
    text: 'One script builds FanPilot, signs it with your Apple Development identity and puts it in your Applications folder.',
    cmds: ['scripts/build-app.sh --install'],
  },
  {
    title: 'Turn on the helper',
    text: 'Open FanPilot, click the fan in the menu bar and choose Install Helper…, then switch FanPilot on in System Settings → General → Login Items. If you use Macs Fan Control, quit it first.',
    cmds: [],
  },
  {
    title: 'Press fn F5',
    text: 'A HUD confirms every step. fn F4 brings the fans back down, fn ⇧F4 returns to Automatic.',
    cmds: [],
  },
];
---
<section class="section install" id="install" aria-labelledby="install-title">
  <div class="wrap install__grid">
    <div class="install__copy">
      <h2 class="h2" id="install-title">Get FanPilot.</h2>
      <p class="lead">Open source, built on your own Mac in a couple of minutes. You'll need an Apple Silicon Mac on macOS 14 or later, and Xcode 16.</p>
      <div class="install__cta">
        <a class="btn btn--primary" href={REPO_URL}><Icon name="github" />{REPO_LABEL}</a>
      </div>
    </div>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step__n tnum" aria-hidden="true">{i + 1}</span>
            <div class="step__body">
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
              {s.cmds.length > 0 && (
                <div class="code">
                  <pre><code>{s.cmds.map((c) => `$ ${c}`).join('\n')}</code></pre>
                  <button class="code__copy" type="button" data-copy={s.cmds.join('\n')} aria-label={`Copy: ${s.cmds.join(' and ')}`}>
                    <Icon name="copy" />
                  </button>
                </div>
              )}
            </div>
          </li>
        ))
      }
      <li class="step step--quiet">
        <span class="step__n" aria-hidden="true"></span>
        <details class="step__body">
          <summary>Uninstall</summary>
          <p>Choose Uninstall Helper from the menu at the bottom of the FanPilot panel, then delete the app. From Terminal:</p>
          <div class="code">
            <pre><code>$ /Applications/FanPilot.app/Contents/MacOS/FanPilot --uninstall-helper
$ rm -rf /Applications/FanPilot.app</code></pre>
            <button class="code__copy" type="button" data-copy="/Applications/FanPilot.app/Contents/MacOS/FanPilot --uninstall-helper&#10;rm -rf /Applications/FanPilot.app" aria-label="Copy uninstall commands"><Icon name="copy" /></button>
          </div>
        </details>
      </li>
    </ol>
  </div>
</section>

<style is:global>
  .install__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .install__copy {
    display: grid;
    gap: 1.5rem;
    position: sticky;
    top: 110px;
  }
  .install__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 0.5rem;
  }
    .steps {
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .step:first-child {
    border-top: 0;
    padding-top: 0.25rem;
  }
  .step__n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    font-weight: 650;
    font-size: 0.9375rem;
    color: var(--fog);
  }
  .step__body {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
  .step__body > p {
    color: var(--fog);
    max-width: 62ch;
  }
  .step--quiet summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--fog);
    list-style-position: outside;
  }
  .step--quiet summary:hover {
    color: var(--frost);
  }
  .code {
    position: relative;
    border-radius: 12px;
    background: var(--ink-2);
    border: 1px solid var(--line);
  }
  .code pre {
    margin: 0;
    padding: 14px 52px 14px 16px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #e6e6e9;
  }
  .code__copy {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--fog);
  }
  .code__copy:hover {
    color: var(--frost);
    background: rgba(255, 255, 255, 0.12);
  }
  .code__copy.is-done {
    color: var(--heat);
  }
  .code__copy .icon {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 960px) {
    .install__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .install__copy {
      position: static;
    }
  }
</style>
